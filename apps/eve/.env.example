# Copy to .env.local and fill in real values (never commit .env.local).
# On Vercel, `vercel env pull` writes most of these for you, including the
# VERCEL_OIDC_TOKEN that eve uses to reach the AI Gateway in development.

# --- Web auth ---------------------------------------------------------------
# HTTP Basic credentials guarding the API routes in production (the browser
# prompts once). Requests fail closed with 401 if these are unset.
EVE_WEB_USERNAME=""
EVE_WEB_PASSWORD=""

# --- Database (Neon Postgres) ---------------------------------------------
# Threads, receipts, reminders, webhooks, automation runs, push subscriptions.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# --- Long-term memory (Supermemory) ---------------------------------------
SUPERMEMORY_API_KEY="sm_..."

# --- App integrations (Composio) ------------------------------------------
# Consumer API key used for tool calls and the Connections manager.
COMPOSIO_API_KEY="ck_..."

# --- File sharing (Vercel Blob) -------------------------------------------
# Backs the share_file tool and the chat-created skill store.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# --- Web push notifications -----------------------------------------------
# Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# --- Telegram channel (optional) ------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET_TOKEN=""
# Comma-separated Telegram user ids allowed to DM the bot.
TELEGRAM_ALLOWED_USER_IDS=""
