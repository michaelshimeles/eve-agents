# Copy to .env.local and fill in real values (never commit .env.local).
# On Vercel, `vercel env pull` writes most of these for you, including the
# VERCEL_OIDC_TOKEN that eve uses to reach the AI Gateway in development.

# --- Database (Neon Postgres) ---------------------------------------------
# Threads, receipts, reminders, webhooks, automation runs, push subscriptions.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# --- Vercel Sandbox workspace console ------------------------------------
# Required to open the files, terminal, process, port, and Sandbox controls
# on a public deployment. Enter it once in the Workspace view; the raw token
# is exchanged for a scoped HttpOnly cookie and is not kept in browser storage.
# Secure production access also needs DATABASE_URL so each Eve session can be
# authorized against its owner-bound saved conversation.
WORKSPACE_ADMIN_TOKEN=""

# --- Long-term memory (Supermemory) ---------------------------------------
SUPERMEMORY_API_KEY="sm_..."

# --- App integrations (Composio) ------------------------------------------
# Consumer API key used for tool calls and the Connections manager.
COMPOSIO_API_KEY="ck_..."

# --- The agent's own email (AgentMail) ------------------------------------
# Gives the agent a real inbox it fully controls, and powers the /email page.
# A key alone is enough: an inbox is provisioned on first use. Optional here -
# the key can instead be pasted on the /email page, which stores it in Neon.
# When both exist, this env var wins.
AGENTMAIL_API_KEY="am_..."
# Optional. Pin an existing inbox instead of provisioning one.
AGENTMAIL_INBOX_ID=""
# Optional. Address to provision, e.g. username "ruth" on a verified domain.
# Without them AgentMail picks a random username on agentmail.to. A custom
# domain is usually easier to connect from the /email page (or by asking the
# agent) - AGENTMAIL_INBOX_DOMAIN overrides that flow when set.
AGENTMAIL_INBOX_USERNAME=""
AGENTMAIL_INBOX_DOMAIN=""
AGENTMAIL_INBOX_DISPLAY_NAME=""
# Optional. Svix signing secret for the inbound webhook. The email schedule
# registers the webhook and stores its secret in Neon, so this is only needed
# when the webhook was created by hand in the AgentMail console.
AGENTMAIL_WEBHOOK_SECRET=""
# Optional. Use api.agentmail.eu for the EU region.
AGENTMAIL_API_BASE_URL=""

# --- File sharing (Vercel Blob) -------------------------------------------
# Backs the Artifacts workspace, share_file, and the chat-created skill store.
# Create this store as PRIVATE. Artifact revisions are immutable and delivered
# through authenticated app routes; exact-version public shares use revocable
# application tokens.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# --- Cloud desktop / computer use (Orgo) ----------------------------------
# A persistent Linux desktop the agent can drive with the computer_* tools.
# Get a key at https://www.orgo.ai/start. Without a key those tools are not
# registered at all. The env var is optional: a key can also be pasted in the
# app under Manage -> Computer (stored in the database; the env var wins when
# both are set).
ORGO_API_KEY="sk_live_..."
# All optional - uncomment only to override. The desktop is found (or created)
# by name, so leaving these unset reuses the same machine every time.
# ORGO_COMPUTER_ID=""            # pin an existing computer, skip discovery
# ORGO_COMPUTER_NAME=""          # default: the agent's name, lowercased
# ORGO_WORKSPACE_ID=""           # pin an existing workspace
# ORGO_WORKSPACE_NAME=""         # default: "eveclaw"
# ORGO_COMPUTER_RAM=""           # GB: 4 (default), 8, 16, 32, 64
# ORGO_COMPUTER_CPU=""           # cores: 1 (default), 2, 4, 8, 16
# ORGO_COMPUTER_RESOLUTION=""    # e.g. "1920x1080x24" (default 1280x720x24)
# ORGO_TASK_TIMEOUT_SECONDS=""   # cap on one computer_task run (default 240)
# ORGO_API_BASE_URL=""           # alternate API host

# --- Local Mac bridge (Ruth Local) ----------------------------------------
# The downloadable macOS helper pairs from Manage and uses the managed,
# outbound-only Neon relay automatically when DATABASE_URL is configured.
# These URL/token values remain available as a direct-tunnel fallback.
RUTH_LOCAL_MCP_URL=""
RUTH_LOCAL_MCP_TOKEN=""
# Optional URL returned by the Download for Mac button. Defaults to the latest
# GitHub release asset named Ruth-Local.dmg.
RUTH_LOCAL_DOWNLOAD_URL=""
# Optional public origin for deep links and the helper's relay API. Vercel's
# deployment URL is discovered automatically; set this only for custom hosts.
RUTH_LOCAL_RELAY_ORIGIN=""
# Optional independent HMAC key for agent-side relay credentials. If unset,
# DATABASE_URL is used as the server-only key. Use at least 32 random characters.
RUTH_LOCAL_RELAY_SECRET=""
# Optional Cloudflare Access service-token pair protecting the named tunnel.
# Set both or neither.
RUTH_LOCAL_CF_ACCESS_CLIENT_ID=""
RUTH_LOCAL_CF_ACCESS_CLIENT_SECRET=""
# Vision model for approved local_computer_task loops. Must support images and
# tool calls through Vercel AI Gateway.
RUTH_LOCAL_COMPUTER_MODEL="anthropic/claude-sonnet-5"
# Optional 10-600 second ceiling for one approved GUI task (default 240).
RUTH_LOCAL_TASK_TIMEOUT_SECONDS=""

# --- Payments (Agentcard) --------------------------------------------------
# Virtual Visa cards the agent can spend, each with a fixed limit. Create a
# backend client under Agentcard Organization -> Developer -> Credentials.
# Manage -> Card uses the backend-only Connect API: a one-time email or phone
# code, no redirect. Chat-side card attachment, prerequisite phone/consent, and
# wallet fallback also use this platform credential server-side; the browser
# sees only Agentcard's single-purpose card-entry/funding URLs. User tokens are
# AES-256-GCM encrypted in Neon (needs DATABASE_URL) with a key derived from the
# backend client secret.
AGENTCARD_CLIENT_ID=""
AGENTCARD_CLIENT_SECRET=""
# Optional. Point at a different MCP server - how the capability is exercised
# without an Agentcard account: `node scripts/agentcard-stub.mjs`, then
# AGENTCARD_MCP_URL="http://127.0.0.1:4546/mcp".
AGENTCARD_MCP_URL=""
# Optional: pin exactly one destination if the owner should be able to ask the
# agent to start connecting in chat. Manage -> Card accepts either directly.
AGENTCARD_OWNER_EMAIL=""
AGENTCARD_OWNER_PHONE=""
# Gate for the Connect API routes (the app itself is open by design).
# Required on a public deployment - connecting fails closed without it;
# loopback `next dev` is exempt. Enter the value under Manage -> Card.
AGENTCARD_ADMIN_TOKEN=""
# Connect REST API base; production defaults to https://api.agentcard.sh.
# Point at scripts/agentcard-stub.mjs only in local development.
AGENTCARD_API_URL=""

# --- iMessage (Photon Spectrum, shared-number router) ----------------------
# Every deployment shares one iMessage number (a Photon Business dedicated
# line). The deployment holding the Spectrum credentials is the ROUTER: it
# receives the Spectrum webhook, keeps the handle -> deployment registry in
# Neon, forwards each text to the right deployment, and sends replies out.
# Other deployments set only IMESSAGE_ROUTER_URL and pair from Manage ->
# iMessage (an OTP is texted from the shared number; needs DATABASE_URL).
#
# Router credentials, from the Photon dashboard (https://app.photon.codes):
SPECTRUM_PROJECT_ID=""
SPECTRUM_PROJECT_SECRET=""
# Signing secret returned once when registering this deployment's
# /api/imessage/spectrum URL as the project webhook.
SPECTRUM_WEBHOOK_SECRET=""
# Optional. Pin conversations to one dedicated line when the project has several.
SPECTRUM_LINE_PHONE=""
# Optional. Point sends at a local stand-in instead of the Spectrum SDK - how
# the capability is exercised without a Photon account:
# `node scripts/spectrum-stub.mjs`, then SPECTRUM_API_BASE_URL="http://127.0.0.1:4547".
SPECTRUM_API_BASE_URL=""
# Non-router deployments: the router deployment's origin. A deployment with
# SPECTRUM_* credentials defaults to itself.
IMESSAGE_ROUTER_URL=""
# Required to read persisted iMessage contents on a public deployment. The
# conversation log fails closed without it; local loopback development is
# exempt. Enter the value once under Manage -> iMessage (kept for that tab).
IMESSAGE_ADMIN_TOKEN=""

# --- Phone (AgentPhone: SMS + iMessage + voice) ---------------------------
# A dedicated number of the agent's own ($3/month), from https://agentphone.ai.
# Unlike the shared Spectrum line above, each deployment provisions its own
# number and talks to the provider directly - no router, no pairing.
# Optional: a key pasted under Manage -> Phone works too (needs DATABASE_URL).
AGENTPHONE_API_KEY=""
# Optional. Point the client at a local stand-in instead of the real API - how
# the capability is exercised without an account, and the only way to exercise
# it without spending money, since AgentPhone has no sandbox or test mode:
# `node scripts/agentphone-stub.mjs`, then
# AGENTPHONE_API_BASE_URL="http://127.0.0.1:4548".
AGENTPHONE_API_BASE_URL=""
# The public https origin AgentPhone should deliver webhooks to. Vercel
# deployments derive this from VERCEL_PROJECT_PRODUCTION_URL automatically;
# set it explicitly behind a custom domain or another host. It is never taken
# from the request's Host header, which the caller controls - provisioning
# refuses rather than registering a callback on a host it cannot vouch for.
AGENTPHONE_CALLBACK_ORIGIN=""
# Required to manage the phone from a deployed app. Provisioning a number
# bills monthly and rotating the key is a credential change, so unlike the
# rest of the manage surface those actions are not left open to anyone who can
# load the page: set any long random string here, then enter it once under
# Manage -> Phone. Without it a deployed app refuses every phone mutation;
# local development over loopback needs no token.
AGENTPHONE_ADMIN_TOKEN=""

# --- Web push notifications -----------------------------------------------
# Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# --- Telegram channel (optional) ------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET_TOKEN=""
# Comma-separated Telegram user ids allowed to DM the bot.
TELEGRAM_ALLOWED_USER_IDS=""

# --- Slack channel (optional) ---------------------------------------------
# Credentials run through Vercel Connect, which holds the workspace's bot
# token and verifies inbound webhooks - there is no SLACK_BOT_TOKEN or
# SLACK_SIGNING_SECRET to manage. Create the client and point its trigger at
# eve's route (eve does not serve Connect's default path):
#   vercel connect create slack --triggers
#   vercel connect detach <uid> --yes
#   vercel connect attach <uid> --triggers --trigger-path /eve/v1/slack --yes
# The Connect client UID, e.g. "slack/ruth". Its presence is also what makes
# Slack offerable as a delivery target in Manage.
SLACK_CONNECT_CLIENT_ID=""
# Your Slack user id (starts with U). Unset means nobody is the owner, so
# everyone is treated as a guest: owner-only tools stay denied and owner-only
# reaction rules never fire. That is the safe direction, not a bug.
SLACK_OWNER_USER_ID=""

# --- Realtime voice (OpenAI) ----------------------------------------------
# Powers the voice orb in the web UI: a live speech-to-speech conversation
# (GPT Realtime over WebRTC) that dispatches real work to the agent. Without
# a key the orb simply doesn't render.
OPENAI_API_KEY="sk-..."

# --- Observability (optional) ---------------------------------------------
# Export one agent-turn event plus its model/tool trace to Raindrop. With no
# key, the hook and exporter are disabled.
RAINDROP_WRITE_KEY=""
# Directly export AI spans and hosted eval results to Braintrust. The Vercel
# Marketplace integration injects this key in production; with no key, local
# tracing stays a no-op and eval results remain under .eve/evals/.
BRAINTRUST_API_KEY=""
# Marketplace destination for production AI spans. The integration injects it;
# local setups may omit it and use the agent-named project fallback instead.
BRAINTRUST_PROJECT_ID=""
# Optional destination override. Takes precedence over BRAINTRUST_PROJECT_ID.
# Default without either value: project_name:<agent name>.
BRAINTRUST_PARENT=""
# Full prompts and replies are recorded by default. Set false to keep span
# structure, timings, token counts, and tool names while dropping message
# bodies. Body recording is forcibly disabled whenever Agentcard backend
# credentials are set, because card-detail MCP results can contain PAN/CVV.
OTEL_RECORD_IO="true"
# Generic OTLP escape hatch when Braintrust is not configured. @vercel/otel
# reads these standard variables directly.
OTEL_EXPORTER_OTLP_ENDPOINT=""
# Optional comma-separated OTLP headers, for example "Authorization=Bearer ...".
OTEL_EXPORTER_OTLP_HEADERS=""
